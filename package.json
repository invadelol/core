{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "clickhouse:migrate": "node ace clickhouse:migration:run",
    "clickhouse:migrate:status": "node ace clickhouse:migration:status",
    "clickhouse:migrate:fresh": "node ace clickhouse:migration:fresh"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js",
    "#types/*": "./app/types/*.js",
    "#utils/*": "./app/utils/*.js",
    "#constants/*": "./app/constants/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@adonisjs/eslint-config": "^2.0.0",
    "@adonisjs/prettier-config": "^1.4.4",
    "@adonisjs/tsconfig": "^1.4.0",
    "@japa/api-client": "^3.1.0",
    "@japa/assert": "^4.0.1",
    "@japa/plugin-adonisjs": "^4.0.0",
    "@japa/runner": "^4.2.0",
    "@swc/core": "1.11.24",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.15.18",
    "@types/node-cron": "^3.0.11",
    "@vitejs/plugin-vue": "^6.0.3",
    "eslint": "^9.26.0",
    "hot-hook": "^0.4.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "ts-node-maintained": "^10.9.5",
    "typescript": "~5.8",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "@adonisjs/auth": "^9.4.0",
    "@adonisjs/cache": "^1.3.0",
    "@adonisjs/core": "^6.18.0",
    "@adonisjs/cors": "^2.2.1",
    "@adonisjs/drive": "^3.4.1",
    "@adonisjs/health": "^2.0.0",
    "@adonisjs/inertia": "^3.1.1",
    "@adonisjs/lucid": "^21.6.1",
    "@adonisjs/redis": "^9.2.0",
    "@adonisjs/view": "^6.2.0",
    "@adonisjs/vite": "^4.0.0",
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/s3-request-presigner": "^3.948.0",
    "@clickhouse/client": "^1.14.0",
    "@fightmegg/riot-api": "^0.0.21",
    "@inertiajs/vue3": "^2.3.6",
    "@tailwindcss/vite": "^4.1.18",
    "@vinejs/vine": "^3.0.1",
    "@vue/server-renderer": "^3.5.26",
    "adonis-autoswagger": "^3.73.0",
    "adonisjs-clickhouse": "^1.0.2",
    "compress-json": "^3.4.0",
    "edge.js": "^6.4.0",
    "lucide-vue-next": "^0.562.0",
    "luxon": "^3.7.2",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.26"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
