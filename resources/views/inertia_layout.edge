<!DOCTYPE html>
<html lang="en" data-theme="system">

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#08090c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta
      name="description"
      content="{{ page.props.description || 'League of Legends statistics: match timelines, lobby-relative scoring and rank history, with nothing in the way.' }}"
    />

    <title inertia>
      invade.lol
    </title>

    {{--
      The stored theme has to be on <html> before the first paint, or a
      dark-theme visitor gets a white flash on every navigation. This is
      the one script that must run synchronously, ahead of the stylesheet.
      Without a choice the page follows the system (`system`), except /app: dark.
    --}}
    <script>
      (function () {
        try {
          var t = localStorage.getItem('invade-theme')
          // The desktop app's page is dark unless the visitor chose otherwise, like the app.
          if (!t && location.pathname === '/app') t = 'dark'
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t)
            var bar = t === 'dark' ? '#08090c' : '#ffffff'
            document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) { m.content = bar })
          }
        } catch (e) {}
      })()
    </script>

    {{--
      For a profile we already hold, the analytics requests are known before
      the browser has even seen the bundle. Announcing them here lets it open
      the connections and start fetching during HTML parse, rather than after
      the JavaScript has downloaded, parsed and hydrated. The page then issues
      these exact URLs and finds the work already underway.
    --}}
    @each(url in (page.props.preload || []))
      <link rel="preload" href="{{ url }}" as="fetch" crossorigin />
    @endeach

    @if(page.props.social)
      <meta property="og:type" content="{{ page.props.social.type || 'profile' }}" />
      <meta property="og:site_name" content="invade.lol" />
      <meta property="og:title" content="{{ page.props.social.title }}" />
      <meta property="og:description" content="{{ page.props.social.description }}" />
      <meta property="og:url" content="{{ page.props.social.url }}" />
      <meta property="og:image" content="{{ page.props.social.image }}" />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content="{{ page.props.social.alt || (page.props.social.title + ' champion artwork and recent stats') }}" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content="{{ page.props.social.title }}" />
      <meta name="twitter:description" content="{{ page.props.social.description }}" />
      <meta name="twitter:image" content="{{ page.props.social.image }}" />
      <meta name="twitter:image:alt" content="{{ page.props.social.alt || (page.props.social.title + ' champion artwork and recent stats') }}" />
    @endif

    @vite(['inertia/app/app.ts', `inertia/pages/${page.component}.vue`])
    @inertiaHead()
    @stack('dumper')
  </head>

  <body class="iv-root min-h-screen">
    @inertia()
  </body>

</html>
