<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f2f2ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0b0e" media="(prefers-color-scheme: dark)" />
    <meta
      name="description"
      content="League of Legends statistics: match timelines, lobby-relative scoring and rank history, with nothing in the way."
    />

    <title inertia>
      invade.lol
    </title>

    {{--
      The stored theme has to be on <html> before the first paint, or a
      dark-theme visitor gets a white flash on every navigation. This is
      the one script that must run synchronously, ahead of the stylesheet.
    --}}
    <script>
      (function () {
        try {
          var t = localStorage.getItem('invade-theme')
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t)
        } catch (e) {}
      })()
    </script>

    {{--
      Archivo is served from our own origin. Pulling it from a font CDN cost a
      DNS lookup, a TLS handshake and a render-blocking stylesheet before the
      first character could be painted; the @font-face rules now ride along in
      the app stylesheet we were already fetching. This one variable file carries
      almost all of the page, so it starts downloading immediately instead of
      waiting for the stylesheet to be parsed.
    --}}
    <link rel="preload" href="/fonts/archivo-latin-wdth.woff2" as="font" type="font/woff2" crossorigin />

    {{--
      For a profile we already hold, the analytics requests are known before
      the browser has even seen the bundle. Announcing them here lets it open
      the connections and start fetching during HTML parse, rather than after
      the JavaScript has downloaded, parsed and hydrated. The page then issues
      these exact URLs and finds the work already underway.
    --}}
    @each(url in (page.props.preload || []))
      <link rel="preload" href="{{ url }}" as="fetch" crossorigin />
    @endeach

    @if(page.props.social)
      <meta property="og:type" content="profile" />
      <meta property="og:site_name" content="invade.lol" />
      <meta property="og:title" content="{{ page.props.social.title }}" />
      <meta property="og:description" content="{{ page.props.social.description }}" />
      <meta property="og:url" content="{{ page.props.social.url }}" />
      <meta property="og:image" content="{{ page.props.social.image }}" />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content="{{ page.props.social.title }} champion artwork and recent stats" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content="{{ page.props.social.title }}" />
      <meta name="twitter:description" content="{{ page.props.social.description }}" />
      <meta name="twitter:image" content="{{ page.props.social.image }}" />
      <meta name="twitter:image:alt" content="{{ page.props.social.title }} champion artwork and recent stats" />
    @endif

    @vite(['inertia/app/app.ts', `inertia/pages/${page.component}.vue`])
    @inertiaHead()
    @stack('dumper')
  </head>

  <body class="min-h-screen">
    @inertia()
  </body>

</html>
