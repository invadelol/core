TZ=UTC
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
APP_KEY=                    # run: node ace generate:key
NODE_ENV=development

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=app

# ClickHouse
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=password
CLICKHOUSE_DB=default

# Storage - MinIO (local) or Cloudflare R2 (production)
DRIVE_DISK=r2
R2_KEY=minioadmin
R2_SECRET=minioadmin
R2_BUCKET=invade-dev
R2_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional logical database (default 0), to keep a second checkout's keys apart
# REDIS_DB=0

# Riot Games API - get a key at https://developer.riotgames.com
RIOT_API_KEY=

# Desktop app sync (docs/desktop-sync.md): kill switches, both default to true
DESKTOP_UPLOADS_ENABLED=true
DESKTOP_RESOLVE_ENABLED=true
# Oldest app version allowed to upload, e.g. 0.2.7 (unset: any)
# DESKTOP_MIN_APP_VERSION=
