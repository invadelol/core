TZ=UTC
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
APP_KEY=                    # run: node ace generate:key
NODE_ENV=development

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=app

# ClickHouse
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=password
CLICKHOUSE_DB=default

# Storage - MinIO (local) or Cloudflare R2 (production)
DRIVE_DISK=r2
R2_KEY=minioadmin
R2_SECRET=minioadmin
R2_BUCKET=invade-dev
R2_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional logical database (default 0), to keep a second checkout's keys apart
# REDIS_DB=0

# Riot Games API - get a key at https://developer.riotgames.com
RIOT_API_KEY=

# Desktop app sync (docs/desktop-sync.md): kill switches. Uploads (the app's own games), observed
# games and player reports default to false, resolve to true; observed and players need uploads on.
DESKTOP_UPLOADS_ENABLED=true
# DESKTOP_OBSERVED_ENABLED=false
# DESKTOP_PLAYERS_ENABLED=false
DESKTOP_RESOLVE_ENABLED=true
# Riot calls per region per 2 minutes the app's uploads may spend (default 30; raise with a production key)
# DESKTOP_RIOT_BUDGET=30
# Oldest app version allowed to upload, e.g. 0.2.7 (unset: any)
# DESKTOP_MIN_APP_VERSION=
# Beta builds: the secret the build workflow sends to upload installers (docs/desktop-sync.md §8.6).
# BETA_UPLOAD_SECRET=
# Bug reports posted on Discord (§9): the bot's token, and optionally another forum than the default.
# DISCORD_BOT_TOKEN=
# DISCORD_BUGS_FORUM=

# The publisher on /privacy and /legal, all optional: an unset line is left out.
# No address means a private individual whose identity the host holds (LCEN 6-III-2).
# LEGAL_HOST is one line, the company first: "Company, address, phone".
# LEGAL_PUBLISHER_NAME=
# LEGAL_CONTACT_EMAIL=
# LEGAL_ADDRESS=
# LEGAL_PHONE=
# LEGAL_HOST=
# LEGAL_UPDATED=

# Local only: a made-up live game on the Live section of the fictional demo accounts (never in production)
# DEMO_LIVE=true

# OpenPanel analytics: server events are sent only when the secret is set
# OPENPANEL_API_URL=https://opapi.lschvn.foo
# OPENPANEL_SCRIPT_URL=https://op.lschvn.foo/op1.js
# OPENPANEL_CLIENT_ID=
# OPENPANEL_CLIENT_SECRET=

# Invade accounts (app/services/accounts): the site's own origin (browser writes must come from it,
# the Discord redirect URL is built on it: <origin>/auth/discord/callback). Without the Discord id
# and secret nobody can sign in. Unset origin: https://invade.lol
# ACCOUNT_ORIGIN=http://localhost:3333
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Local only: Discord answered by `node scripts/oauth_mock.mjs 3364` (ignored in production)
# OAUTH_MOCK_ORIGIN=http://127.0.0.1:3364

# Clips (app/services/clips): local (default, files under CLIPS_DIR, default ./storage) or drive
# (the DRIVE_DISK object storage, served through signed addresses). Limits per clip and account.
# CLIPS_STORAGE=local
# CLIPS_DIR=
# CLIPS_MAX_MB=40
# CLIPS_PER_ACCOUNT=20
